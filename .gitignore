# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# HTML files generated by AsciiDoc.
*.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Visual Studio Code related stuff.
.vscode

# Github token. Both cases: Git is case-insensitive on Windows but NOT on
# Linux/macOS, so the lowercase pattern alone does not protect a clone.
github_token
GITHUB_TOKEN
*.token

# goreleaser dist directory.
dist/

# Gradle caches and build output.
.gradle/
.intellijPlatform/
.qodana/
.run/
build/

# NOTE: gradle/ must NOT be ignored. It holds the version catalog
# (gradle/libs.versions.toml) that build.gradle.kts resolves every `libs.*`
# reference against, plus the wrapper. Ignoring it makes fresh clones
# unbuildable. Belt-and-braces against a global excludesFile with *.jar:
!gradle/
!gradle/libs.versions.toml
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
