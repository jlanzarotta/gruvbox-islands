<idea-plugin>
    <id>com.jlanzarotta.gruvbox.islands</id>

    <name>Gruvbox Islands Light/Dark Hard/Medium/Soft</name>

    <vendor url="https://github.com/jlanzarotta/gruvbox-islands">Jeff Lanzarotta</vendor>

    <description><![CDATA[
      A Gruvbox theme family for the Islands UI.
      Six variants &mdash; dark and light, each in hard, medium and soft contrast.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_dark_hard"
                path="themes/gruvbox_dark_hard/gruvbox_dark_hard.theme.json"
                targetUi="islands"
        />

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_dark_medium"
                path="themes/gruvbox_dark_medium/gruvbox_dark_medium.theme.json"
                targetUi="islands"
        />

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_dark_soft"
                path="themes/gruvbox_dark_soft/gruvbox_dark_soft.theme.json"
                targetUi="islands"
        />

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_light_hard"
                path="themes/gruvbox_light_hard/gruvbox_light_hard.theme.json"
                targetUi="islands"
        />

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_light_medium"
                path="themes/gruvbox_light_medium/gruvbox_light_medium.theme.json"
                targetUi="islands"
        />

        <themeProvider
                id="com.jlanzarotta.gruvbox.islands.gruvbox_light_soft"
                path="themes/gruvbox_light_soft/gruvbox_light_soft.theme.json"
                targetUi="islands"
        />

    </extensions>

</idea-plugin>
